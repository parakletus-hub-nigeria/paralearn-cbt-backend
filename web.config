<?xml version="1.0" encoding="utf-8"?>
<!-- iisnode host config for Windows App Service: runs the compiled NestJS app (dist/main.js).
     iisnode passes its named pipe in process.env.PORT, which main.ts already listens on. -->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NestApp">
          <match url=".*" />
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <!-- wwwroot is read-only under WEBSITE_RUN_FROM_PACKAGE, so iisnode cannot write log files beside the app -->
    <iisnode node_env="production" loggingEnabled="false" devErrorsEnabled="false" />
  </system.webServer>
</configuration>
