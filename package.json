{
  "name": "paralearn-cbt-microservice",
  "version": "1.0.0",
  "description": "High-throughput autonomous Computer-Based Testing (CBT) microservice for ParaLearn",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/bullmq": "^11.0.4",
    "bullmq": "^5.71.0",
    "ioredis": "^5.5.0",
    "@prisma/client": "^6.16.2",
    "class-validator": "^0.14.2",
    "class-transformer": "^0.5.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/bcrypt": "^5.0.2",
    "prisma": "^6.16.2",
    "typescript": "^5.7.3"
  }
}
